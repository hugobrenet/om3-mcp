# Example only: install real deployment configuration outside Git.
# The process reads environment variables; it does not load this file itself.
OPENSVC_MCP_LISTEN_ADDR=0.0.0.0:8443
OPENSVC_MCP_TLS_CERT_FILE=/etc/opensvc-mcp/tls/server.crt
OPENSVC_MCP_TLS_KEY_FILE=/etc/opensvc-mcp/tls/server.key
OPENSVC_MCP_OAUTH_RESOURCE_URL=https://dev5-vip.opensvc.com:8443/mcp
# Optional human-readable name; this is the default.
# OPENSVC_MCP_OAUTH_RESOURCE_NAME="OpenSVC Daemon MCP"
# Replace with the actual issuer of access tokens intended for MCP.
OPENSVC_MCP_OAUTH_ISSUER=https://auth.example.test/application/o/opensvc-mcp/
# Optional for a private SSO CA; otherwise use system roots.
# OPENSVC_MCP_OAUTH_CA_FILE=/etc/opensvc-mcp/ca/sso.pem
# Stage 2 needs no client secret and no daemon catalogue.
